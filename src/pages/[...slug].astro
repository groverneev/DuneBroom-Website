---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DiagramImage from '../components/DiagramImage.astro';
export async function getStaticPaths() {
  return (await getCollection('technical')).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'technical'> }
const { entry } = Astro.props;
const { Content } = await render(entry);
const system = entry.id === 'system-logic';
---
<Layout title={entry.data.title} description={entry.data.description}>
  <main id="main-content" class="bg-background">
    <article class="py-16 max-w-[960px] mx-auto px-5 sm:px-8">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-2 mt-0">{entry.data.title}</h1>
      <p class="text-lg text-muted mb-10">{system ? 'Process Overview' : 'Hardware Implementation'}</p>
      <DiagramImage kind={system ? 'workflow' : 'hardware'} />
      <div class="article-content"><Content /></div>
      {system && <DiagramImage kind="collection" />}
    </article>
  </main>
</Layout>
