---
import { socialLinks } from '../data/social';
interface Props { large?: boolean }
const { large = false } = Astro.props;
---
<div class:list={["flex", large ? "gap-3" : "gap-1"]}>
  {socialLinks.map(link => (
    <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}
       class:list={['text-muted hover:text-foreground transition-colors rounded flex items-center justify-center', large ? 'w-11 h-11 rounded-lg border border-border bg-card-bg hover:bg-background' : 'p-2 -ml-2 first:ml-0 rounded-md']}
    ><Fragment set:html={link.svg} /></a>
  ))}
</div>
