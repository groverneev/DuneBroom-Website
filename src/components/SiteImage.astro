---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  class?: string;
  style?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}
const { src, alt, width, sizes, ...attributes } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/*', { eager: true });
const image = images[`../assets/${src.replace(/^\//, '')}`]?.default;
if (!image) throw new Error(`Missing image: ${src}`);
const displayWidth = width ?? image.width;
const displayHeight = Math.round(displayWidth * image.height / image.width);
const widths = [...new Set([320, 640, 960, 1280, 1600, Math.min(image.width, 1600)].filter(w => w <= image.width))].sort((a, b) => a - b);
---
<Image {...attributes} src={image} alt={alt} width={displayWidth} height={displayHeight}
  widths={sizes ? widths : undefined} sizes={sizes} format="webp" />
