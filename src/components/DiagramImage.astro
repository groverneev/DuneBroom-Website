---
import SiteImage from './SiteImage.astro';
interface Props { kind: 'workflow' | 'hardware' | 'collection' }
const diagrams = {
  workflow: { src: '/Figure_1_Operational_Workflow.png', title: 'Autonomous operational workflow' },
  hardware: { src: '/Figure_2_Hardware_Architecture.png', title: 'Hardware architecture' },
  collection: { src: '/Figure_3_Collection_Sequence.png', title: 'Debris collection sequence' },
};
const { kind } = Astro.props;
const diagram = diagrams[kind];
---
<figure class="diagram" aria-labelledby={`${kind}-caption`}>
  <SiteImage src={diagram.src} alt={diagram.title} loading="lazy" class="block w-full h-auto rounded-md" />
  <figcaption id={`${kind}-caption`}>{diagram.title}</figcaption>
</figure>
