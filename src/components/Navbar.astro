---
import { navLinks } from '../data/navigation';
import ThemeButton from './ThemeButton.astro';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<nav aria-label="Main navigation" class="sticky top-0 z-50 w-full bg-background border-b border-border transition-colors duration-300">
  <div class="max-w-[1200px] mx-auto px-4 flex items-center justify-between h-16">
    <a href="/" class="font-bold text-xl text-foreground no-underline rounded px-2 py-1">DuneBroom</a>
    <div class="hidden lg:flex items-center gap-6">
      <ul class="flex gap-7 list-none p-0 items-center">
        {navLinks.map(link => (
          <li><a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}
            class:list={['no-underline transition-colors relative py-1.5 font-medium text-sm', pathname === link.href ? 'text-foreground border-b-2 border-accent' : 'text-muted hover:text-foreground']}>
            {link.label}
          </a></li>
        ))}
      </ul>
      <ThemeButton />
    </div>
    <div class="lg:hidden flex items-center gap-2">
      <ThemeButton />
      <button id="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" class="p-2 rounded-lg hover:bg-surface text-foreground">
        <svg aria-hidden="true" width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path id="menu-icon" stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" hidden class="border-t border-border lg:hidden">
    <ul class="max-w-[1200px] mx-auto list-none flex flex-col gap-1 px-4 py-4 m-0">
      {navLinks.map(link => (
        <li><a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}
          class:list={['block py-2 px-3 rounded-lg no-underline transition-colors font-medium text-sm', pathname === link.href ? 'text-foreground bg-surface' : 'text-muted hover:bg-surface hover:text-foreground']}>
          {link.label}
        </a></li>
      ))}
    </ul>
  </div>
</nav>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle')!;
  const menu = document.querySelector<HTMLElement>('#mobile-menu')!;
  function setOpen(open: boolean) {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.querySelector('#menu-icon')?.setAttribute('d', open ? 'M6 18L18 6M6 6l12 12' : 'M4 6h16M4 12h16M4 18h16');
  }
  toggle.addEventListener('click', () => setOpen(menu.hasAttribute('hidden')));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && !menu.hidden) { setOpen(false); toggle.focus(); }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', () => setOpen(false));
</script>
